# StaleCheck Environment Configuration

# Tavily API Configuration (Live factual search retrieval)
TAVILY_API_KEY=

# Bifrost AI Gateway / Multi-Provider LLM Proxy
BIFROST_URL=http://localhost:8080/openai/v1
BIFROST_KEY=

# Optional direct provider fallback
OPENAI_API_KEY=

# Model assignments (Bifrost provider/model format)
LOCAL_MODEL=openai/gpt-4o-mini
EXTRACT_MODEL=openai/gpt-4o-mini
ANALYST_MODEL=openai/gpt-4o-mini
JUDGE_MODEL=anthropic/claude-3-5-sonnet

# Server Configuration
PORT=8000
ALLOWED_ORIGINS=*
